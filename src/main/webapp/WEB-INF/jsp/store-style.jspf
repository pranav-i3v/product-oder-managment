<style>
    body {
        font-family: sans-serif;
        background: #fff;
        margin: 0;
        color: #222;
    }

    header {
        padding: 14px 20px;
        border-bottom: 1px solid #999;
        background: #f7f7f7;
    }

    header, nav, .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    main {
        max-width: 900px;
        margin: 24px auto;
        padding: 0 16px;
    }

    .box, .card {
        background: #f7f7f7;
        border: 1px solid #aaa;
        border-radius: 3px;
        padding: 16px;
        margin: 12px 0;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 12px;
    }

    input {
        padding: 7px;
        margin: 4px 0 8px;
        box-sizing: border-box;
        border: 1px solid #999;
        border-radius: 3px;
    }

    button {
        padding: 7px 12px;
        background: #ddd;
        border: 1px solid #999;
        border-radius: 3px;
        cursor: pointer;
    }

    .error {
        color: #b00020;
        margin: 10px 0;
    }

    .message {
        color: #225522;
        margin: 10px 0;
    }

    .muted {
        color: #666;
    }

    a {
        color: #234f87;
    }

    .form-label {
        display: grid;
        grid-template-columns: 140px minmax(0, 230px);
        align-items: center;
        column-gap: 8px;
        margin-bottom: 10px;
    }

    .form-label input {
        width: 100%;
        min-width: 0;
    }

    .product-actions {
        justify-content: flex-start;
    }

    summary {
        padding: 7px 12px;
        background: #ddd;
        border: 1px solid #999;
        border-radius: 3px;
        cursor: pointer;
    }

    @media (max-width: 520px) {
        header, nav {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>